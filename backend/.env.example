APP_NAME=deepdocs-ai
APP_ENV=development
DEBUG=false
# JSON array of explicit frontend origins, including scheme and port.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
# Host-run FastAPI; Compose overrides this to http://qdrant:6333.
QDRANT_URL=http://localhost:6333
# Optional for hosted Qdrant; requires HTTPS when set. Never use URL credentials.
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=deepdocs_chunks
# Optional single-process embedded Qdrant fallback (omit for server mode).
# QDRANT_LOCAL_PATH=./.qdrant-local

# Optional: /health, ingestion and /search work with these unset.
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_SECONDS=30
RAG_TOP_K_DEFAULT=5
RAG_MAX_CONTEXT_CHARS=12000

# Optional evaluation judge; never falls back to production LLM credentials.
EVAL_JUDGE_PROVIDER=openai_compatible
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_BASE_URL=https://api.openai.com/v1
EVAL_JUDGE_TIMEOUT_SECONDS=30
EVAL_JUDGE_MAX_INPUT_CHARS=60000

# Step 6 defaults preserve character chunking and dense search.
CHUNKING_STRATEGY=character
TOKEN_CHUNK_SIZE=200
TOKEN_CHUNK_OVERLAP=32
RETRIEVAL_STRATEGY=dense
RETRIEVAL_CANDIDATE_COUNT=20
RRF_CONSTANT=60
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_CANDIDATE_COUNT=20
RERANKER_BATCH_SIZE=16

# Deployment: set APP_ENV=production and DEBUG=false in host configuration.
# Quality-first portfolio: RETRIEVAL_STRATEGY=hybrid_rerank (defaults remain dense).
# PORT is consumed by python start.py / the Docker entrypoint.
PORT=8000
# Container default; mount a persistent volume here owned by UID 10001.
# HF_HOME=/home/appuser/.cache/huggingface
# Set only after downloading ALL models into the configured cache.
# HF_HUB_OFFLINE=1
