VITE_API_BASE_URL=http://localhost:8000
# Browser-side limit. Match MAX_UPLOAD_SIZE_MB in the backend; the server is authoritative.
VITE_MAX_UPLOAD_SIZE_MB=10

# Required at production build time. Set the real public backend HTTPS URL on the host.
# VITE_ variables are public: never put Qdrant or LLM credentials here.
